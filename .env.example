# Copiar a .env solo si no existe. Ollama local no requiere clave Google.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
# Opcional, únicamente para MODEL_PROVIDER=google:
GOOGLE_API_KEY=
# Redis persistente del proyecto: docker compose up -d --wait
REDIS_URL=redis://localhost:16379
VECTOR_STORE=redis
EMBEDDING_MODEL=bge-m3
MODELO=qwen3:8b
PREFIJO=etmunoz_ollama
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
UMBRAL=0.43
